<div class="settings-header">
    <h3>{{t "Configurações"}}</h3>
    <button event-click="settings:close" id="btn-close-menu" class="close-btn" aria-label="{{t 'Fechar'}}">&times;</button>
</div>

<div class="settings-content">

    <section class="settings-card">
        <h4 class="settings-card-title"><i class="fa-solid fa-table-columns"></i> {{t "Centrais"}}</h4>
        <button type="button" class="settings-btn" event-click="central:open" data-central="issues">
            <i class="fa-solid fa-clipboard-check"></i>
            <span>{{t "Central de Revisões"}}</span>
            <i class="fa-solid fa-chevron-right settings-btn-arrow"></i>
        </button>
        <button type="button" class="settings-btn" event-click="central:open" data-central="book">
            <i class="fa-solid fa-book"></i>
            <span>{{t "Central do Livro"}}</span>
            <i class="fa-solid fa-chevron-right settings-btn-arrow"></i>
        </button>
        <button type="button" class="settings-btn" event-click="central:open" data-central="ai">
            <i class="fa-solid fa-robot"></i>
            <span>{{t "Central de IA"}}</span>
            <i class="fa-solid fa-chevron-right settings-btn-arrow"></i>
        </button>
        <button type="button" class="settings-btn" event-click="central:open" data-central="system">
            <i class="fa-solid fa-gears"></i>
            <span>{{t "Central do Sistema"}}</span>
            <i class="fa-solid fa-chevron-right settings-btn-arrow"></i>
        </button>
    </section>

    <section class="settings-card">
        <h4 class="settings-card-title"><i class="fa-solid fa-palette"></i> {{t "Aparência"}}</h4>
        <div class="settings-row">
            <span class="settings-row-text">
                <strong>{{t "Modo escuro"}}</strong>
                <small>{{t "Alterna entre o tema claro e o escuro."}}</small>
            </span>
            <label class="switch">
                <input event-change="theme:toggle" type="checkbox" id="theme-toggle">
                <span class="slider"></span>
            </label>
        </div>
        <details class="settings-details" id="chat-bg-details">
            <summary>
                <span class="settings-row-text">
                    <strong>{{t "Plano de fundo do chat"}}</strong>
                    <small>{{t "Estrelas, nebulosa, órbitas ou cor sólida, para cada tema."}}</small>
                </span>
                <i class="fa-solid fa-chevron-down settings-chevron"></i>
            </summary>
            <div class="settings-form">
        <div class="settings-row">
            <span class="settings-row-text">
                <strong>{{t "Tema escuro"}}</strong>
                <small>{{t "Estrelas, nebulosa, órbitas ou uma cor sólida."}}</small>
            </span>
            <div class="settings-bg-controls">
                <select id="chat-bg-mode-dark" class="settings-input settings-select" event-change="chat-bg:changed" data-theme="dark" data-field="mode">
                    <option value="stars">{{t "Estrelas"}}</option>
                    <option value="nebula">{{t "Nebulosa"}}</option>
                    <option value="orbits">{{t "Órbitas"}}</option>
                    <option value="solid">{{t "Cor sólida"}}</option>
                </select>
                <input type="color" id="chat-bg-color-dark" class="settings-color" event-input="chat-bg:changed" data-theme="dark" data-field="color" title="{{t 'Cor de fundo'}}" hidden>
            </div>
        </div>
        <div class="settings-row">
            <span class="settings-row-text">
                <strong>{{t "Tema claro"}}</strong>
                <small>{{t "Escolha o fundo e, nos que aceitam, a cor."}}</small>
            </span>
            <div class="settings-bg-controls">
                <select id="chat-bg-mode-light" class="settings-input settings-select" event-change="chat-bg:changed" data-theme="light" data-field="mode">
                    <option value="stars">{{t "Estrelas"}}</option>
                    <option value="nebula">{{t "Nebulosa"}}</option>
                    <option value="orbits">{{t "Órbitas"}}</option>
                    <option value="solid">{{t "Cor sólida"}}</option>
                </select>
                <input type="color" id="chat-bg-color-light" class="settings-color" event-input="chat-bg:changed" data-theme="light" data-field="color" title="{{t 'Cor de fundo'}}" hidden>
            </div>
        </div>
            </div>
        </details>
    </section>

    <section class="settings-card">
        <h4 class="settings-card-title"><i class="fa-solid fa-spell-check"></i> {{t "Idioma e correção"}}</h4>
        <div class="settings-row">
            <span class="settings-row-text">
                <strong>{{t "Correção ortográfica e gramatical"}}</strong>
                <small>{{t "Sublinha palavras desconhecidas, aponta palavras repetidas e mostra os avisos no rodapé do editor."}}</small>
            </span>
            <label class="switch">
                <input event-change="spellcheck:toggle" type="checkbox" id="spellcheck-toggle" checked>
                <span class="slider"></span>
            </label>
        </div>
        <div class="settings-row">
            <span class="settings-row-text">
                <strong>{{t "Idioma da correção ortográfica"}}</strong>
                <small>{{t "Palavras desconhecidas ficam sublinhadas; clique com o botão direito para ver sugestões, ignorar ou adicionar ao dicionário. Nomes e apelidos das fichas do livro nunca são marcados."}}</small>
            </span>
            <select id="spell-language-select" class="settings-input settings-select" event-change="language:changed">
                <option value="pt-BR">Português (Brasil)</option>
                <option value="en-US">English (US)</option>
                <option value="es-ES">Español</option>
                <option value="fr-FR">Français</option>
            </select>
        </div>
    </section>

    <section class="settings-card">
        <h4 class="settings-card-title"><i class="fa-solid fa-wand-magic-sparkles"></i> {{t "Inteligência artificial"}}</h4>
        <details class="settings-details" id="ai-details">
            <summary>
                <span class="settings-row-text">
                    <strong>{{t "Conta e modelo"}}</strong>
                    <small id="ai-summary-value">—</small>
                </span>
                <i class="fa-solid fa-chevron-down settings-chevron"></i>
            </summary>
            <div class="settings-form">
                <label class="settings-label" for="ai-provider-select">{{t "Conta de IA"}}</label>
                <select id="ai-provider-select" class="settings-input" event-change="ai-settings:changed"
                    data-field="account">
                </select>

                <label class="settings-label" for="ai-model-select">{{t "Modelo"}}</label>
                <select id="ai-model-select" class="settings-input" event-change="ai-settings:changed"
                    data-field="model">
                </select>

                <button type="button" class="settings-btn" event-click="central:open" data-central="ai">
                    <i class="fa-solid fa-key"></i>
                    <span>{{t "Contas e chaves de API (Central de IA)"}}</span>
                    <i class="fa-solid fa-chevron-right settings-btn-arrow"></i>
                </button>
            </div>
        </details>
    </section>
</div>
