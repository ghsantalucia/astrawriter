<div class="tpl-editor">
  <div class="tpl-banner">
    <i class="fa-solid fa-clone"></i>
    <span>
      {{t "Você está editando"}} <strong>{{t "templates"}}</strong> {{t "(os modelos usados para criar fichas e capítulos do perfil"}}
      <strong>{{profile}}</strong>{{t "), e não um livro. Aqui não há sincronização: use"}} <strong>{{t "Salvar template"}}</strong>.
      {{t "Só o corpo muda; os campos (variáveis) são fixos."}}
    </span>
  </div>
  <div class="tpl-layout">
    <nav class="tpl-list" id="tpl-list" aria-label="{{t 'Templates'}}"></nav>
    <section class="tpl-main">
      <header class="tpl-main-head">
        <strong id="tpl-kind-title"></strong>
        <span class="tpl-state" id="tpl-state"></span>
      </header>
      <div class="tpl-vars" id="tpl-vars"></div>
      <div class="tpl-editor-host" id="tpl-editor-host">
        <div class="tpl-editor-el" id="tpl-editor"></div>
      </div>
    </section>
  </div>
</div>
