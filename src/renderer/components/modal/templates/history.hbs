<div class="history-modal">
  <p class="history-desc">
    Versões registradas de <strong>{{fileTitle}}</strong>. Ao restaurar uma versão, o conteúdo guardado das versões
    posteriores é apagado.
  </p>

  {{#if restoredFrom}}
    <p class="history-restored">
      <i class="fa-solid fa-rotate-left"></i>
      A versão atual foi restaurada da versão
      {{#if restoredFrom.actorLabel}}de <strong>{{restoredFrom.time}}</strong>
      (<span class="log-actor {{restoredFrom.actorClass}}">{{restoredFrom.actorLabel}}</span>){{else}}<strong>original</strong> do arquivo{{/if}}.
      Abaixo estão as versões anteriores a ela.
    </p>
  {{/if}}

  {{#if entries.length}}
    <ul class="history-list">
      {{#each entries}}
        <li class="history-item{{#if isCurrent}} current{{/if}}">
          <div class="history-row">
            <span class="log-tag log-tag-{{action}}">{{action}}</span>
            <span class="log-actor {{actorClass}}">{{actorLabel}}</span>
            {{#if actorDetail}}<span class="log-actor-detail">{{actorDetail}}</span>{{/if}}
            <span class="log-time">{{time}}</span>
          </div>
          <div class="history-row history-row-sub">
            <span class="log-summary">{{summary}}</span>
            {{#if isCurrent}}
              <span class="history-current-label">versão atual</span>
            {{else if canRestore}}
              <button type="button" class="btn-history-restore" data-entry-id="{{id}}">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Restaurar esta versão
              </button>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="history-empty">
      {{#if restoredFrom}}
        Não há versões anteriores a esta.
      {{else}}
        Nenhuma alteração registrada para este arquivo ainda. As próximas edições sincronizadas aparecerão aqui.
      {{/if}}
    </p>
  {{/if}}
</div>
