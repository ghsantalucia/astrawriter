<div class="history-modal">
  <p class="history-desc">
    {{t "Versões registradas de"}} <strong>{{fileTitle}}</strong>. {{t "Ao restaurar uma versão, o conteúdo guardado das versões posteriores é apagado."}}
  </p>

  {{#if restoredFrom}}
    <p class="history-restored">
      <i class="fa-solid fa-rotate-left"></i>
      {{#if restoredFrom.actorLabel}}{{t "A versão atual foi restaurada da versão de"}} <strong>{{restoredFrom.time}}</strong>
      (<span class="log-actor {{restoredFrom.actorClass}}">{{restoredFrom.actorLabel}}</span>).{{else}}{{{t "A versão atual foi restaurada da versão <strong>original</strong> do arquivo."}}}{{/if}}
      {{t "Abaixo estão as versões anteriores a ela."}}
    </p>
  {{/if}}

  {{#if entries.length}}
    <ul class="history-list">
      {{#each entries}}
        <li class="history-item{{#if isCurrent}} current{{/if}}">
          <div class="history-row">
            <span class="log-tag log-tag-{{action}}">{{action}}</span>
            <span class="log-actor {{actorClass}}">{{actorLabel}}</span>
            {{#if actorDetail}}<span class="log-actor-detail">{{actorDetail}}</span>{{/if}}
            <span class="log-time">{{time}}</span>
          </div>
          <div class="history-row history-row-sub">
            <span class="log-summary">{{summary}}</span>
            {{#if isCurrent}}
              <span class="history-current-label">{{t "versão atual"}}</span>
            {{else if canRestore}}
              <button type="button" class="btn-history-restore" data-entry-id="{{id}}">
                <i class="fa-solid fa-clock-rotate-left"></i>
                {{t "Restaurar esta versão"}}
              </button>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="history-empty">
      {{#if restoredFrom}}
        {{t "Não há versões anteriores a esta."}}
      {{else}}
        {{t "Nenhuma alteração registrada para este arquivo ainda. As próximas edições sincronizadas aparecerão aqui."}}
      {{/if}}
    </p>
  {{/if}}
</div>
