<!-- Editor TOASTUI (os painéis flutuantes são inseridos pelo EditorKit) -->
<div id="markdown-editor"></div>

<!-- Rodapé discreto: estatísticas do texto e status do salvamento automático -->
<footer class="editor-footer">
  <div class="editor-stats" id="editor-stats">
    <button
      type="button"
      class="review-pill hidden"
      id="btn-review"
      title="{{t 'Abrir a Central de Revisões'}}"
      event-click="central:open"
      data-central="issues"
    >
      <span class="review-dot"></span>
      <span class="review-text">{{t "Tudo certo"}}</span>
    </button>
    <span id="stat-words">{{t "0 palavras"}}</span>
    <span class="stat-sep">·</span>
    <span id="stat-read">{{t "~0 min de leitura"}}</span>
    <span class="stat-sep">·</span>
    <span id="stat-links">{{t "0 conexões wiki"}}</span>
    <span class="stat-item hidden" id="stat-invalid-item">
      <span class="stat-sep">·</span>
      <button
        type="button"
        class="stat-warn"
        id="stat-invalid-btn"
        title="{{t 'Links internos que apontam para arquivos que não existem mais. Clique para ir ao primeiro; clique de novo para o próximo.'}}"
      >
        <i class="fa-solid fa-circle-exclamation"></i>
        <span id="stat-invalid">{{t "0 links internos inválidos"}}</span>
      </button>
    </span>
    <span class="stat-item hidden" id="stat-spell-item">
      <span class="stat-sep">·</span>
      <button
        type="button"
        class="stat-warn"
        id="stat-spell-btn"
        title="{{t 'Palavras que o corretor não reconhece e palavras repetidas em sequência'}}"
      >
        <i class="fa-solid fa-circle-exclamation"></i>
        <span id="stat-spell">{{t "0 problemas ortográficos"}}</span>
      </button>
    </span>
  </div>
  <div
    id="save-status-indicator"
    class="save-status hidden"
    title="{{t 'Status de salvamento automático'}}"
  >
    <i class="fas fa-circle"></i>
    <span class="status-text"></span>
  </div>
</footer>

<!-- OVERLAY REUTILIZÁVEL DO EDITOR (AI Lock / Nenhum Arquivo Selecionado) -->
<div id="editor-overlay-container" class="editor-overlay hidden"></div>