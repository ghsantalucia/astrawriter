<div class="wizard">
  {{#if isMulti}}
  <ol class="wizard-progress">
    {{#each progress}}
    <li class="wizard-progress-item {{#if active}}active{{/if}} {{#if done}}done{{/if}}" title="{{title}}">
      <span class="wizard-progress-dot">{{#if done}}<i class="fa-solid fa-check"></i>{{else}}{{number}}{{/if}}</span>
    </li>
    {{/each}}
  </ol>
  <p class="wizard-step-counter">{{t "Passo {current} de {total}" current=current total=total}}</p>
  {{/if}}

  <h4 class="wizard-step-title">{{step.title}}</h4>
  {{#if step.description}}<p class="wizard-step-description">{{step.description}}</p>{{/if}}

  <div class="wizard-fields">
    {{#each step.fields}}
    <div class="wizard-field {{#if required}}required{{/if}}" data-field="{{id}}">
      <label class="wizard-label" for="{{id}}">{{label}}{{#if required}}<span class="wizard-required">*</span>{{/if}}</label>
      {{#if isSelect}}
      <select id="{{id}}" name="{{id}}" class="wizard-input wizard-select" data-field-id="{{id}}" {{#if ../readOnly}}disabled{{/if}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{else if isEvents}}
      <div class="wizard-events" data-events-host="{{id}}" data-placeholder="{{placeholder}}"></div>
      <input type="hidden" id="{{id}}" name="{{id}}" data-field-id="{{id}}" value="{{value}}" />
      {{else if isTextarea}}
      <textarea id="{{id}}" name="{{id}}" class="wizard-input wizard-textarea" data-field-id="{{id}}" rows="{{rows}}" placeholder="{{placeholder}}" {{#if ../readOnly}}disabled{{/if}}>{{value}}</textarea>
      {{else}}
      <input id="{{id}}" name="{{id}}" type="text" class="wizard-input" data-field-id="{{id}}" value="{{value}}" placeholder="{{placeholder}}" autocomplete="off" spellcheck="false" {{#if suggestions.length}}list="{{id}}-suggestions"{{/if}} {{#if ../readOnly}}disabled{{/if}} />
      {{#if suggestions.length}}<datalist id="{{id}}-suggestions">{{#each suggestions}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
      {{/if}}
      {{#if hint}}<small class="wizard-hint">{{hint}}</small>{{/if}}
      <span class="wizard-field-error" hidden>{{t "Campo obrigatório"}}</span>
    </div>
    {{/each}}
  </div>

  <p class="wizard-error" hidden></p>

  <div class="wizard-footer">
    <button type="button" class="btn-modal btn-secondary" data-action="cancel">{{t "Cancelar"}}</button>
    <span class="wizard-footer-spacer"></span>
    {{#if canSkip}}<button type="button" class="btn-modal btn-secondary" data-action="skip">{{t "Pular e criar"}}</button>{{/if}}
    {{#unless isFirst}}<button type="button" class="btn-modal btn-secondary" data-action="back">{{t "Voltar"}}</button>{{/unless}}
    {{#if isLast}}
    {{#unless readOnly}}<button type="button" class="btn-modal btn-primary" data-action="submit">{{submitLabel}}</button>{{/unless}}
    {{else}}
    <button type="button" class="btn-modal btn-primary" data-action="next">{{t "Próximo"}}</button>
    {{/if}}
  </div>
</div>
