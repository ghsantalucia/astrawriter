<!-- Aba de Navegação (3 Abas) -->
<nav class="explorer-tabs">
  <button class="tab-btn" folder="notes">
    <i class="fa-regular fa-bookmark"></i>
    <span>{{t "Anotações"}}</span>
    <span class="tab-badge" data-badge="notes" hidden></span>
  </button>
  <button class="tab-btn active" folder="content">
    <i class="fa-regular fa-pen-to-square"></i>
    <span>{{t "Escrita"}}</span>
    <span class="tab-badge" data-badge="content" hidden></span>
  </button>
  <button class="tab-btn" folder="assets">
    <i class="fa-regular fa-compass"></i>
    <span>{{t "Mundo"}}</span>
    <span class="tab-badge" data-badge="assets" hidden></span>
  </button>
</nav>

<!-- Cronômetro de produtividade (tempo de escrita da sessão) -->
<div class="productivity-bar" id="productivity-bar" data-status="paused">
  <button
    type="button"
    class="prod-icon-btn"
    event-click="central:open"
    data-central="system"
    data-tab="productivity"
    title="{{t 'Abrir Produtividade (gráfico e registros)'}}"
    aria-label="{{t 'Abrir Produtividade'}}"
  >
    <i class="fa-regular fa-clock prod-icon"></i>
  </button>
  <span class="prod-time" id="prod-time">00:00:00</span>
  <span class="prod-status" id="prod-status">{{t "pausado"}}</span>
  <span class="prod-spacer"></span>
  <button type="button" class="prod-btn" id="prod-toggle" event-click="productivity:toggle" title="{{t 'Iniciar o cronômetro'}}">
    <i class="fa-solid fa-play"></i>
  </button>
  <button type="button" class="prod-btn" id="prod-reset" event-click="productivity:reset" title="{{t 'Zerar: encerra o registro atual e recomeça'}}">
    <i class="fa-solid fa-rotate-left"></i>
  </button>
  <button type="button" class="prod-auto" id="prod-auto" event-click="productivity:auto">{{t "Auto"}}</button>
</div>

<!-- Barra de pesquisa (título e conteúdo dos arquivos) -->
<div class="explorer-search">
  <i class="fa-solid fa-magnifying-glass explorer-search-icon"></i>
  <input
    type="text"
    id="explorer-search-input"
    class="explorer-search-input"
    placeholder="{{t 'Título, texto ou #tag (vírgula separa termos)'}}"
    autocomplete="off"
    spellcheck="false"
    event-input="search:changed"
  />
  <button
    type="button"
    id="explorer-search-clear"
    class="explorer-search-clear"
    title="{{t 'Limpar pesquisa'}}"
    event-click="search:clear"
    hidden
  >
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>

<!-- Mini toolbar: criar (capítulo/anotação) e alternar arquivos avançados -->
<div
  class="explorer-toolbar"
  role="toolbar"
  aria-label="{{t 'Ferramentas do explorer'}}"
>
  <label
    class="mini-btn mini-toggle"
    data-tooltip="{{t 'Arquivos avançados'}}"
    aria-label="{{t 'Arquivos avançados'}}"
  >
    <input
      type="checkbox"
      id="mode-toggle"
      event-click="advanced-mode:toggle"
    />
    <i class="fa-regular fa-eye-slash mini-off"></i>
    <i class="fa-regular fa-eye mini-on"></i>
  </label>
  <button
    type="button"
    class="mini-btn"
    data-tooltip="{{t 'Abrir ou fechar todas as pastas'}}"
    aria-label="{{t 'Abrir ou fechar todas as pastas'}}"
    event-click="folders:toggle-all"
  >
    <i class="fa-solid fa-folder-tree"></i>
  </button>
  <button
    type="button"
    class="mini-btn"
    data-tab="content"
    data-tooltip="{{t 'Novo capítulo'}}"
    aria-label="{{t 'Novo capítulo'}}"
    event-click="chapter:create"
  >
    <i class="fa-solid fa-file-circle-plus"></i>
  </button>
  <button
    type="button"
    class="mini-btn"
    data-tab="notes"
    data-tooltip="{{t 'Nova pasta'}}"
    aria-label="{{t 'Nova pasta'}}"
    event-click="folder:create"
    data-parent="notes"
  >
    <i class="fa-solid fa-folder-plus"></i>
  </button>
  <button
    type="button"
    class="mini-btn mini-ai-lock"
    id="btn-notes-ai-lock"
    data-tab="notes"
    data-tooltip="{{t 'Bloquear ou liberar a escrita da IA nas anotações'}}"
    aria-label="{{t 'Bloquear ou liberar a escrita da IA nas anotações'}}"
    event-click="notes:toggle-ai-lock"
  >
    <i class="fa-solid fa-lock mini-locked"></i>
    <i class="fa-solid fa-lock-open mini-unlocked"></i>
  </button>
  <button
    type="button"
    class="mini-btn"
    data-tab="notes"
    data-tooltip="{{t 'Nova anotação'}}"
    aria-label="{{t 'Nova anotação'}}"
    event-click="note:create"
  >
    <i class="fa-solid fa-file-circle-plus"></i>
  </button>
</div>

<!-- Mensagem exibida quando a pesquisa não encontra nada na aba atual -->
<div id="search-empty" class="search-empty" hidden>
  <i class="fa-regular fa-face-frown"></i>
  <span>{{t "Sem resultados para a pesquisa"}}</span>
</div>

<!-- Conteúdo da Árvore de Arquivos -->
<div id="file-tree" class="file-tree"></div>