<li
  data-path="{{relativePath}}"
  data-absolute-path="{{absolutePath}}"
  class="{{#if isAdvanced}}advanced-item{{/if}} {{#if isReadonly}}readonly{{/if}} {{#if isTemp}}has-temp{{/if}}"
>
  <span
    class="file-name"
    data-path="{{relativePath}}"
    data-absolute-path="{{absolutePath}}"
    event-click="editor:open-file"
  >
    <i class="fa-regular fa-file-lines notes-icon icon-file"></i>
    <span class="file-text">
      <span class="file-title-wrapper">
        <span class="file-title">{{#if titleHtml}}{{{titleHtml}}}{{else}}{{meta.title}}{{/if}}</span>
        {{#if isTemp}}<span class="dirty-asterisk">*</span>{{/if}}
        {{#if isReadonly}}<i class="fa-solid fa-lock file-lock" title="{{t 'Somente leitura: este arquivo não pode ser editado'}}"></i>{{/if}}
      </span>
      {{#if snippet}}<span class="file-snippet">{{{snippet}}}</span>{{/if}}
      {{#if tagChips.length}}<span class="file-tags">{{#each tagChips}}<span class="tag-chip {{colorClass}}">{{tag}}</span>{{/each}}</span>{{/if}}
    </span>
  </span>
  {{#if canEditData}}
  <button
    type="button"
    class="item-edit-btn{{#unless canDelete}} no-delete{{/unless}}"
    title="{{t 'Editar dados do arquivo (nome e variáveis)'}}"
    aria-label="{{t 'Editar dados de {name}' name=meta.title}}"
    event-click="file-data:edit"
    data-path="{{absolutePath}}"
  >
    <i class="fa-solid fa-pen"></i>
  </button>
  {{/if}}
  {{#if canDelete}}
  <button
    type="button"
    class="item-delete-btn"
    title="{{t 'Excluir'}}"
    aria-label="{{t 'Excluir {name}' name=meta.title}}"
    event-click="file:delete"
    data-path="{{absolutePath}}"
  >
    <i class="fa-regular fa-trash-can"></i>
  </button>
  {{/if}}
</li>
