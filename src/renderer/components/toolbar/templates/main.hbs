<!-- Guias dos arquivos (hoje só há uma; preparada para várias no futuro) -->
<div class="file-tabs" role="tablist" id="file-tabs">
  <div
    class="file-tab hidden"
    id="file-tab"
    role="tab"
    aria-selected="true"
    tabindex="0"
    event-click="tab:activate"
  >
    <span class="file-tab-name" id="file-tab-name"></span>
    <span
      class="file-tab-dirty hidden"
      id="file-tab-dirty"
      title="{{t 'Rascunho não sincronizado'}}"
    >*</span>
    <button
      type="button"
      class="file-tab-edit"
      id="file-tab-edit"
      event-click="file-data:toggle"
      title="{{t 'Editar os dados do arquivo (nome e variáveis)'}}"
      aria-label="{{t 'Editar os dados do arquivo'}}"
    >
      <i class="fa-solid fa-pen"></i>
    </button>
  </div>
  <!-- Capítulo aberto: três guias (manuscrito, esboço e análise); a ativa mostra o nome, as outras só o ícone -->
  <div class="chapter-tabs hidden" id="chapter-tabs" role="presentation">
    <div
      class="file-tab chapter-tab"
      role="tab"
      tabindex="0"
      data-kind="draft"
      data-file="2_draft.md"
      data-name="Manuscrito"
      title="{{t 'Manuscrito — O texto do capítulo'}}"
      event-click="editor:open-file"
      data-path=""
      data-absolute-path=""
    >
      <i class="fa-solid fa-feather-pointed chapter-tab-icon"></i>
      <span class="file-tab-name">{{t "Manuscrito"}}</span>
      <span class="file-tab-dirty hidden">*</span>
      <span class="ai-dot hidden" title="{{t 'Alterado pela IA (some 3 segundos depois de abrir o arquivo)'}}"></span>
      <button
        type="button"
        class="file-tab-edit chapter-tab-edit hidden"
        event-click="file-data:toggle"
        title="{{t 'Editar os dados do arquivo (nome e variáveis)'}}"
        aria-label="{{t 'Editar os dados do arquivo'}}"
      >
        <i class="fa-solid fa-pen"></i>
      </button>
    </div>
    <div
      class="file-tab chapter-tab"
      role="tab"
      tabindex="0"
      data-kind="outline"
      data-file="1_outline.md"
      data-name="Esboço"
      title="{{t 'Esboço — Plano do capítulo: o que escrever (serve de prompt para a IA)'}}"
      event-click="editor:open-file"
      data-path=""
      data-absolute-path=""
    >
      <i class="fa-solid fa-lightbulb chapter-tab-icon"></i>
      <span class="file-tab-name">{{t "Esboço"}}</span>
      <span class="file-tab-dirty hidden">*</span>
      <span class="ai-dot hidden" title="{{t 'Alterado pela IA (some 3 segundos depois de abrir o arquivo)'}}"></span>
      <button
        type="button"
        class="file-tab-edit chapter-tab-edit hidden"
        event-click="file-data:toggle"
        title="{{t 'Editar os dados do arquivo (nome e variáveis)'}}"
        aria-label="{{t 'Editar os dados do arquivo'}}"
      >
        <i class="fa-solid fa-pen"></i>
      </button>
    </div>
    <div
      class="file-tab chapter-tab"
      role="tab"
      tabindex="0"
      data-kind="analysis"
      data-file="3_analysis.md"
      data-name="Análise"
      title="{{t 'Análise — Análise, planejamento e pistas, gerados depois da escrita'}}"
      event-click="editor:open-file"
      data-path=""
      data-absolute-path=""
    >
      <i class="fa-solid fa-magnifying-glass-chart chapter-tab-icon"></i>
      <span class="file-tab-name">{{t "Análise"}}</span>
      <span class="file-tab-dirty hidden">*</span>
      <span class="ai-dot hidden" title="{{t 'Alterado pela IA (some 3 segundos depois de abrir o arquivo)'}}"></span>
      <button
        type="button"
        class="file-tab-edit chapter-tab-edit hidden"
        event-click="file-data:toggle"
        title="{{t 'Editar os dados do arquivo (nome e variáveis)'}}"
        aria-label="{{t 'Editar os dados do arquivo'}}"
      >
        <i class="fa-solid fa-pen"></i>
      </button>
    </div>
  </div>
</div>
<div class="toolbar-actions">
  <button
    id="btn-narrator"
    class="btn-toolbar-icon"
    event-click="narrator:toggle"
    title="{{t 'Ouvir o arquivo aberto em voz alta (Ctrl+Shift+O)'}}"
    aria-label="{{t 'Ouvir o arquivo em voz alta'}}"
    disabled
  >
    <i class="fa-solid fa-volume-high" id="narrator-icon"></i>
  </button>
  <button
    id="btn-narrator-stop"
    class="btn-toolbar-icon hidden"
    event-click="narrator:stop"
    title="{{t 'Parar a leitura'}}"
    aria-label="{{t 'Parar a leitura'}}"
  >
    <i class="fa-solid fa-stop"></i>
  </button>
  <button
    id="btn-spelling"
    class="btn-toolbar-icon"
    event-click="central:open"
    data-central="issues"
    data-tab="spelling"
    title="{{t 'Correção ortográfica: abre a aba Ortografia da Central de Revisões'}}"
    aria-label="{{t 'Correção ortográfica'}}"
  >
    <i class="fa-solid fa-spell-check"></i>
  </button>
  <button
    id="btn-autolink"
    class="btn-toolbar-icon"
    event-click="autolink:run"
    title="{{t 'Cria links automáticos para os nomes e apelidos de fichas do livro encontrados neste texto'}}"
    disabled
  >
    <span class="icon-link-stars" aria-hidden="true">
      <i class="fa-solid fa-link"></i>
      <svg class="icon-ai-star" viewBox="0 0 24 24" focusable="false">
        <path
          d="M12 0C12.6 7.2 16.8 11.4 24 12 16.8 12.6 12.6 16.8 12 24 11.4 16.8 7.2 12.6 0 12 7.2 11.4 11.4 7.2 12 0Z"
        />
      </svg>
    </span>
    <span>{{t "Auto-link"}}</span>
  </button>
  <button
    id="btn-history"
    class="btn-toolbar-icon"
    event-click="history:open-modal"
    title="{{t 'Histórico de versões do arquivo'}}"
    disabled
  >
    <i class="fa-solid fa-clock-rotate-left"></i>
    <span>{{t "Histórico"}}</span>
  </button>
  <div class="export-wrap">
    <button
      id="btn-export"
      class="btn-toolbar-icon"
      event-click="export:toggle-menu"
      title="{{t 'Exportar o arquivo aberto no editor'}}"
      aria-haspopup="menu"
      aria-expanded="false"
      disabled
    >
      <i class="fa-solid fa-download"></i>
      <span>{{t "Exportar"}}</span>
    </button>
    <div class="export-menu hidden" id="export-menu" role="menu">
      <button
        type="button"
        role="menuitem"
        class="export-item"
        event-click="export:file"
        data-format="md"
      >
        <i class="fa-brands fa-markdown"></i>
        <span>Markdown <small>.md</small></span>
      </button>
      <button
        type="button"
        role="menuitem"
        class="export-item"
        event-click="export:file"
        data-format="docx"
      >
        <i class="fa-solid fa-file-word"></i>
        <span>Word <small>.docx</small></span>
      </button>
      <button
        type="button"
        role="menuitem"
        class="export-item"
        event-click="export:file"
        data-format="pdf"
      >
        <i class="fa-solid fa-file-pdf"></i>
        <span>PDF <small>.pdf</small></span>
      </button>
    </div>
  </div>
  <button id="btn-save" class="btn-save-gsap" event-click="sync:open-modal">
    <svg class="btn-border-svg">
      <rect
        class="btn-border-path"
        x="1"
        y="1"
        width="98.5%"
        height="93%"
        rx="3"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    <span class="btn-text">{{t "Sincronizar"}}</span>
  </button>
</div>