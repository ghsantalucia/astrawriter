{
  "name": "draftweaver-v2",
  "productName": "Astra Writer",
  "version": "1.0.0",
  "description": "Astra Writer: editor de livros com assistente de IA, para universos narrativos consistentes",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "typecheck": "tsc --noEmit",
    "g": "node scripts/create-component.js",
    "docs:web": "jsdoc -c jsdoc.json",
    "file-map": "node scripts/project-map.js > maps/project-map.txt",
    "code-map": "node scripts/code-map.js > maps/code-map.txt",
    "event-map": "node scripts/event-map.js > maps/event-map.txt",
    "docs": "npm run file-map && npm run code-map && npm run event-map && npm run docs:web",
    "format": "prettier --write \"src/**/*.{js,ts,json,css,md}\"",
    "release": "node scripts/release.js"
  },
  "keywords": [],
  "author": {
    "name": "ghsantalucia",
    "email": "ghsantalucia@proton.me"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.6.6",
    "electron": "44.2.0",
    "electron-builder": "^26.18.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@heyputer/puter.js": "^2.6.5",
    "@toast-ui/editor": "^3.2.2",
    "chokidar": "^5.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-pt": "^4.0.0",
    "dompurify": "^3.4.17",
    "electron-squirrel-startup": "^1.0.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "handlebars": "^4.7.9",
    "html-to-docx": "^1.8.0",
    "hunspell-asm": "^4.0.2",
    "js-yaml": "^3.15.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "mitt": "^3.0.1",
    "pdf-parse": "^1.1.1"
  }
}
